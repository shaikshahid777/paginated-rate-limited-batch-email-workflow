      "id": "82ba2ab4-2d6e-4b1b-a860-b0360e1ad2ad",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// Reset shared state for a clean run\nconst s = $getWorkflowStaticData('global');\ns.records = [];\ns.currentPage = 1;\ns.totalRecords = 0;\ns.totalSucceeded = 0;\ns.totalFailed = 0;\nreturn $input.all();"
      },
      "id": "e5b89dfa-8f19-44f2-bfc4-8c27832c2631",
      "name": "Init State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// Emit the next page number and page size for the HTTP request\nconst s = $getWorkflowStaticData('global');\nconst pageSize = $('Config').first().json.pageSize;\nreturn [{ json: { currentPage: s.currentPage, pageSize: pageSize } }];"
      },
      "id": "26ef6861-d5a2-4387-aba5-8d985ea89e9c",
      "name": "Prepare Page Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "url": "https://jsonplaceholder.typicode.com/users",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "_page",
              "value": "={{ $json.currentPage }}"
            },
            {
              "name": "_limit",
              "value": "={{ $json.pageSize }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f26c94ef-c98a-4476-82e6-a43d5eb45a11",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        128
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Store this page's records and decide whether more pages exist\nconst s = $getWorkflowStaticData('global');\nconst items = $input.all();\nconst valid = items.filter(i => i.json && i.json.id !== undefined && i.json.id !== null);\nfor (const it of valid) {\n  s.records.push({ id: it.json.id, name: it.json.name, email: it.json.email });\n}\ns.currentPage = s.currentPage + 1;\nconst hasMore = valid.length > 0;\nreturn [{ json: { hasMore: hasMore, fetched: valid.length, totalSoFar: s.records.length } }];"
      },
      "id": "63148a7a-af2b-4bfa-9ce5-4e1b2c50be3a",
      "name": "Accumulate & Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.hasMore }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "56481b56-6e56-4962-9e15-2c2ecb76765f",
      "name": "More Pages?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1344,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// Emit the full aggregated dataset, one item per record\nconst s = $getWorkflowStaticData('global');\nconst records = s.records || [];\ns.totalRecords = records.length;\ns.totalSucceeded = 0;\ns.totalFailed = 0;\nreturn records.map(r => ({ json: r }));"
      },
      "id": "7e730506-439a-47ac-84d4-d204f6938a5b",
      "name": "Combine All Pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// Produce the execution summary metrics\nconst s = $getWorkflowStaticData('global');\nreturn [{ json: {\n  totalRecords: s.totalRecords || 0,\n  totalSucceeded: s.totalSucceeded || 0,\n  totalFailed: s.totalFailed || 0,\n  generatedAt: new Date().toISOString()\n} }];"
      },
      "id": "5b98f19b-b19f-4771-abe8-5bb681ed73df",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://jsonplaceholder.typicode.com/{{ $json.id % 4 === 0 ? \"invalid_endpoint_simulated\" : \"posts\" }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $json.email }}"
            },
            {
              "name": "name",
              "value": "={{ $json.name }}"
            },
            {
              "name": "userId",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "27415ea7-59f2-489a-a4c5-df0967e38854",
      "name": "Send Email (Simulated)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2016,
        192
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Classify each processed record as Sent or Failed and track counts\nconst s = $getWorkflowStaticData('global');\nconst j = $input.item.json;\nconst failed = j.error !== undefined && j.error !== null;\nif (failed) {\n  s.totalFailed = (s.totalFailed || 0) + 1;\n} else {\n  s.totalSucceeded = (s.totalSucceeded || 0) + 1;\n}\nconst errMsg = failed ? (j.error.message ? j.error.message : String(j.error)) : null;\nreturn { json: { id: (j.userId !== undefined ? j.userId : j.id), email: j.email, name: j.name, status: failed ? 'Failed' : 'Sent', error: errMsg } };"
      },
      "id": "aa911fa4-2e6f-461e-bebc-f1dd78e6564e",
      "name": "Check Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        192
      ]
    },
    {
      "parameters": {
        "amount": "={{ $('Config').first().json.waitSeconds }}"
      },
